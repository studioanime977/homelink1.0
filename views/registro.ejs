<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Registro</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50">
  <%- include('parts/header') %>

  <main class="container mx-auto max-w-lg py-10">
    <h1 class="text-2xl font-bold mb-6">Crear cuenta</h1>

    <form id="formRegistro" action="/api/registro" method="POST" enctype="multipart/form-data" class="space-y-4">
      <input name="nombre" placeholder="Nombre" class="w-full p-2 border rounded" required>
      <input name="apellido" placeholder="Apellido" class="w-full p-2 border rounded" required>
      <input name="correo" type="email" placeholder="Correo" class="w-full p-2 border rounded" required>
      <input name="contrasena" type="password" placeholder="Contraseña" class="w-full p-2 border rounded" required>
      <input name="confirmarContrasena" type="password" placeholder="Confirmar contraseña" class="w-full p-2 border rounded" required>
      <input name="foto" type="file" accept="image/*" class="w-full">
      <button class="bg-[#ee4d2d] text-white px-4 py-2 rounded">Registrarse</button>
    </form>
  </main>

  <%- include('parts/footer') %>
</body>
</html>
