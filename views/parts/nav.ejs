<nav class="container mx-auto flex items-center justify-between h-16 px-4">
  <a href="/" class="text-2xl font-bold text-[#ee4d2d]">HomeLink VPN</a>

  <ul class="hidden md:flex space-x-8">
    <li><a href="/HTML/servicio.html">Inicio</a></li>
    <li><a href="/HTML/como funciona.html">Cómo Funciona</a></li>
    <li><a href="/HTML/planes.html">Planes</a></li>
    <% if (user) { %>
      <li><a href="/carrito">Carrito</a></li>
      <li><a href="/perfil">Perfil</a></li>
      <li><a href="/HTML/mis compras.html">Mis Compras</a></li>
      <li><a href="/HTML/monitoreo.html">Monitoreo</a></li>
    <% } %>
  </ul>

  <% if (!user) { %>
    <div>
      <a href="/HTML/login.html" class="mr-4">Iniciar Sesión</a>
      <a href="/HTML/registro.html" class="bg-[#ee4d2d] text-white px-4 py-2 rounded-md">Registrarse</a>
    </div>
  <% } else { %>
    <div class="relative">
      <button id="profileButton" class="w-10 h-10 rounded-full overflow-hidden">
        <% if (user.foto) { %>
          <img src="<%= user.foto %>" class="w-full h-full object-cover">
        <% } else { %>
          <span class="bg-[#ee4d2d] w-full h-full flex items-center justify-center text-white font-bold">
            <%= user.nombre.charAt(0) %>
          </span>
        <% } %>
      </button>
      <div id="profileMenu" class="hidden absolute right-0 mt-2 w-48 bg-white rounded-lg shadow-lg py-2 z-50">
        <a href="/api/logout" class="block px-4 py-2 text-red-600">Cerrar Sesión</a>
      </div>
    </div>
  <% } %>
</nav>
<script>
document.getElementById('profileButton')?.addEventListener('click',()=>{
  document.getElementById('profileMenu').classList.toggle('hidden');
});
</script>
